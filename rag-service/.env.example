# ===== 应用配置 =====
APP_NAME=SmartAgri RAG Service
APP_ENV=dev
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=9001

# 允许跨域来源，多个值用逗号分隔
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8080

# ===== Qdrant 配置 =====
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_SCHEME=http
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_AGRICULTURE=agriculture_knowledge
QDRANT_VECTOR_SIZE=1536
QDRANT_TIMEOUT_SECONDS=10

# ===== 模型配置（OpenAI 兼容：含阿里云百炼 Model Studio）=====
# 百炼：OPENAI_BASE_URL 使用兼容端点；OPENAI_API_KEY 使用控制台创建的 DashScope API Key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
OPENAI_TIMEOUT_SECONDS=120

# 向量：须用 OpenAI 兼容 /embeddings（如 text-embedding-v4）；免费额度见控制台「文本向量化」
# 勿填 multimodal-embedding-v1 等，多模态走独立 API，与本项目当前实现不兼容
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-v4
# 与 QDRANT_VECTOR_SIZE 必须一致（v3/v4 支持自定义维度，如 1536、1024）
EMBEDDING_DIMENSIONS=1536

# 对话：模型 Code 与百炼控制台一致；qwen3.5-flash / qwen3.5-plus 等常见有免费额度
LLM_PROVIDER=bailian
LLM_MODEL=qwen3.5-flash
LLM_TEMPERATURE=0.38
# 结构化 JSON 输出长度上限；觉得回答偏短时可调到 4096
LLM_MAX_TOKENS=3072
# 检索/模型异常时是否回退本地 mock（默认 true，Qdrant 未起时仍可演示；生产可设 false）
LLM_FALLBACK_TO_MOCK=true
KNOWLEDGE_RETRIEVAL_FALLBACK_TO_MOCK=true

# —— 若使用 OpenAI 官方，可改回例如： ——
# OPENAI_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini

# ===== Spring Boot 对接 =====
SPRING_BACKEND_BASE_URL=http://localhost:8080/api
SPRING_CONTEXT_API_PATH=/ai/rag/context
SPRING_CONTEXT_TIMEOUT_SECONDS=5

# ===== 知识导入配置 =====
KNOWLEDGE_ROOT_DIR=knowledge
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ===== 公开知识抓取配置 =====
CRAWL_ENABLED=true
CRAWL_USER_AGENT=SmartAgriKnowledgeBot/1.0 (+https://localhost/smart-agri-rag)
CRAWL_REQUEST_TIMEOUT_SECONDS=15
CRAWL_REQUEST_INTERVAL_SECONDS=1.0
CRAWL_MIN_CONTENT_LENGTH=260
CRAWL_DATA_ROOT_DIR=data
CRAWL_SOURCES_CONFIG=sources/china_agri_sources.yaml
CRAWL_MAX_ARTICLES_PER_SOURCE=20

# ===== Neo4j 农业概念图谱 =====
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=请填写与 docker-compose 或本地实例一致的密码
# 多库实例可填库名；单库默认留空
# NEO4J_DATABASE=neo4j
NEO4J_MAX_SUBGRAPH_PATHS=400
