# 复制到仓库根目录并重命名为 .env 后使用：docker compose up -d --build
# （根目录 .env 已被 gitignore，勿提交）

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=smart_agriculture
MYSQL_USER=smartagri
MYSQL_PASSWORD=smartagri
# 宿主机映射端口（避免与本机已有 3306 冲突）
MYSQL_PORT=3307

# ---------- Neo4j ----------
# 必填；生产环境请替换为随机强口令（openssl rand -base64 24）
# 使用项目专属变量名，避免被宿主机的全局环境变量 NEO4J_PASSWORD 覆盖
SMARTAGRI_NEO4J_PASSWORD=请替换为随机强口令
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ---------- Qdrant ----------
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334

# ---------- JWT（必填，须 ≥32 字符；openssl rand -base64 48 生成）----------
JWT_SECRET_KEY=请替换为至少32字节的随机串
# ---------- CORS / Swagger ----------
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:8090
SWAGGER_ENABLED=true
# 首次启动或旧库升级时设为 true；生产环境建议 false 并用 SQL 迁移脚本
WARNING_AUTO_MIGRATE=true

# ---------- RAG（OpenAI 兼容，如百炼；不配密钥时可用 mock）----------
RAG_PORT=9001
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 本地无大模型/向量数据时可临时改为 true，生产环境保持 false 以暴露真实故障
LLM_FALLBACK_TO_MOCK=false
KNOWLEDGE_RETRIEVAL_FALLBACK_TO_MOCK=false
RAG_CORS_ALLOW_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:8090

# ---------- Spring 调大模型（AI 助手等；可与上项共用百炼 Key）----------
SMART_AGRI_AI_API_KEY=
SMART_AGRI_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SMART_AGRI_AI_FALLBACK_TO_MOCK=false

# ---------- 对外端口 ----------
SERVER_HTTP_PORT=8090
WEB_HTTP_PORT=8088
